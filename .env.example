APP_ENV=local
POSTGRES_DB=boerse_dashboard
POSTGRES_USER=boerse
POSTGRES_PASSWORD=boerse
DATABASE_URL=postgresql+psycopg://boerse:boerse@postgres:5432/boerse_dashboard
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_VISIBILITY_TIMEOUT_SECONDS=259200
CELERY_TASK_TIME_LIMIT_SECONDS=172800
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=169200
WORKER_CONCURRENCY=1
REDIS_MAXMEMORY=256mb
API_INTERNAL_BASE_URL=http://backend:8000
NEXT_PUBLIC_API_BASE_URL=/api/v1
APP_AUTH_ENABLED=0
APP_AUTH_USER=
APP_AUTH_PASSWORD=
API_RATE_LIMIT_ENABLED=0
API_RATE_LIMIT_REQUESTS=120
API_RATE_LIMIT_WINDOW_SECONDS=60
API_ACCESS_LOG_ENABLED=0
PUSHOVER_USER_KEY=
PUSHOVER_APP_TOKEN=
PUSHOVER_DRY_RUN=1
FMP_API_KEY=
# Marketaux is read only by the backend. Never use a NEXT_PUBLIC_ variable.
MARKETAUX_API_KEY=
MARKETAUX_LANGUAGES=de,en
MARKETAUX_DAILY_LIMIT=90
MARKETAUX_CACHE_TTL_SECONDS=3600
MARKETAUX_EMPTY_TTL_SECONDS=600
MARKETAUX_FAILURE_BACKOFF_SECONDS=300
MARKETAUX_REQUEST_TIMEOUT_SECONDS=8
MARKETAUX_MIN_MATCH_SCORE=10
SEC_USER_AGENT=boerse-dashboard-web local@example.com
