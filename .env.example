APP_ENV=local
POSTGRES_DB=boerse_dashboard
POSTGRES_USER=boerse
POSTGRES_PASSWORD=boerse
DATABASE_URL=postgresql+psycopg://boerse:boerse@postgres:5432/boerse_dashboard
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
WORKER_CONCURRENCY=1
REDIS_MAXMEMORY=256mb
API_INTERNAL_BASE_URL=http://backend:8000
NEXT_PUBLIC_API_BASE_URL=/api/v1
APP_AUTH_ENABLED=0
APP_AUTH_USER=
APP_AUTH_PASSWORD=
PUSHOVER_USER_KEY=
PUSHOVER_APP_TOKEN=
PUSHOVER_DRY_RUN=1
SEC_USER_AGENT=boerse-dashboard-web local@example.com
