APP_ENV=hetzner

# Public domain and TLS certificate email
APP_DOMAIN=dashboard.example.com
ACME_EMAIL=admin@example.com

# GHCR image source
GHCR_OWNER=druckkette
IMAGE_TAG=latest

# Frontend/backend routing
API_INTERNAL_BASE_URL=http://backend:8000
NEXT_PUBLIC_API_BASE_URL=/api/v1
CORS_ORIGINS=["https://dashboard.example.com"]

# Private dashboard access. Keep enabled unless another auth layer is in front.
APP_AUTH_ENABLED=1
APP_AUTH_USER=boerse
APP_AUTH_PASSWORD=CHANGE_ME_LONG_RANDOM_DASHBOARD_PASSWORD
API_RATE_LIMIT_ENABLED=1
API_RATE_LIMIT_REQUESTS=360
API_RATE_LIMIT_WINDOW_SECONDS=60
API_ACCESS_LOG_ENABLED=1

# Database
POSTGRES_DB=boerse_dashboard
POSTGRES_USER=boerse
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD
DATABASE_URL=postgresql+psycopg://boerse:CHANGE_ME_LONG_RANDOM_PASSWORD@postgres:5432/boerse_dashboard

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_VISIBILITY_TIMEOUT_SECONDS=259200
CELERY_TASK_TIME_LIMIT_SECONDS=172800
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=169200
REDIS_MAXMEMORY=512mb
WORKER_CONCURRENCY=1

# Optional notifications and data providers
PUSHOVER_USER_KEY=
PUSHOVER_APP_TOKEN=
PUSHOVER_DRY_RUN=0
FMP_API_KEY=
SEC_USER_AGENT=boerse-dashboard-web your-email@example.com
