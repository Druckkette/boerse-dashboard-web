APP_ENV=nas

# GHCR image source
GHCR_OWNER=druckkette
IMAGE_TAG=latest

# Public ports on the NAS
FRONTEND_PORT=3000
BACKEND_BIND=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=["http://NAS-IP-ODER-HOSTNAME:3000"]

# Private dashboard access bootstrap.
# These values can later be changed in /setup > Konfiguration & Secrets > Security.
APP_AUTH_ENABLED=1
APP_AUTH_USER=boerse
APP_AUTH_PASSWORD=CHANGE_ME_LONG_RANDOM_DASHBOARD_PASSWORD
API_RATE_LIMIT_ENABLED=1
API_RATE_LIMIT_REQUESTS=240
API_RATE_LIMIT_WINDOW_SECONDS=60
API_ACCESS_LOG_ENABLED=1

# Database
POSTGRES_DB=boerse_dashboard
POSTGRES_USER=boerse
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD
DATABASE_URL=postgresql+psycopg://boerse:CHANGE_ME_LONG_RANDOM_PASSWORD@postgres:5432/boerse_dashboard

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_VISIBILITY_TIMEOUT_SECONDS=259200
CELERY_TASK_TIME_LIMIT_SECONDS=172800
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=169200
REDIS_MAXMEMORY=256mb
WORKER_CONCURRENCY=1

# Enables the setup button that restarts frontend/backend/worker/scheduler through the Docker socket.
# Keep this enabled only on your private NAS deployment.
NAS_CONTROL_ENABLED=1

# Optional Pushover alerts. Keep these only in .env.nas / NAS environment, never in git.
PUSHOVER_USER_KEY=
PUSHOVER_APP_TOKEN=
PUSHOVER_DRY_RUN=0

# Optional Financial Modeling Prep key for deeper stock fundamentals.
FMP_API_KEY=

# Required for real SEC 13F refreshes. Use a real contact email per SEC Fair Access Policy.
SEC_USER_AGENT=boerse-dashboard-web your-email@example.com

# Optional update script behavior
PRUNE_OLD_IMAGES=0
